{% extends 'layouts/page.njk' %}

{% from "govuk/components/tabs/macro.njk" import govukTabs %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/table/macro.njk" import govukTable %}

{% block beforeContent %}
  {{ super() }}
  <nav>
    <a class="govuk-back-link" href="/projects/{{ projectId }}/check-baseline-import">Back</a>
  </nav>
{% endblock %}

{% block content %}
  {{ appHeading({
    text: heading,
    caption: caption
  }) }}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
      <h2 class="govuk-heading-m">Summary</h2>

      {{ govukTable({
        head: [
          { text: "Unit type" },
          { text: "Size" },
          { text: "Units" }
        ],
        rows: [
          [{ text: "Area habitats" }, { text: "" }, { text: "" }],
          [{ text: "Hedgerows" }, { text: "" }, { text: "" }],
          [{ text: "Watercourses" }, { text: "" }, { text: "" }]
        ]
      }) }}
    </div>
    <div class="govuk-grid-column-full">
      <h2 class="govuk-heading-m">Habitat details</h2>

      {{ govukButton({
        text: "Show map",
        classes: "govuk-button--secondary",
        href: "#"
      }) }}

      {{ govukTabs({
        items: [
          {
            label: "Areas",
            id: "area-habitats",
            panel: { html: "<div>Temp area-habitats data</div>" }
          },
          {
            label: "Hedgerows",
            id: "hedgerows",
            panel: { html: "<div>Temp hedgerows data</div>" }
          },
          {
            label: "Watercourses",
            id: "watercourses",
            panel: { html: "<div>Temp watercourse data</div>" }
          }
        ]
      }) }}
    </div>
    <div class="govuk-grid-column-full">
      {{ govukButton({
        text: "Continue",
        href: "#",
        classes: "govuk-!-margin-right-2"
      }) }}

      {{ govukButton({
        text: "Upload a different file",
        classes: "govuk-button--secondary",
        href: "/projects/" + projectId + "/upload-baseline-file"
      }) }}
    </div>
  </div>
{% endblock %}
