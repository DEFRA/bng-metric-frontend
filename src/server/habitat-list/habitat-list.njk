{% extends 'layouts/page.njk' %}

{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
{% from "govuk/components/tabs/macro.njk" import govukTabs %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/table/macro.njk" import govukTable %}

{% block beforeContent %}
  {{ super() }}
  {{ govukBackLink({
    text: "Back",
    href: backHref
  }) }}
{% endblock %}

{% block content %}
  {{ appHeading({
    text: heading,
    caption: caption
  }) }}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
      <h2 class="govuk-heading-m">Summary</h2>

      {% if isPostIntervention %}
        {{ govukTable({
          head: [
            { text: "Unit type" },
            { text: "Size" },
            { text: "Baseline units" },
            { text: "Post-intervention units" },
            { text: "Net unit change" },
            { text: "Net % change" },
            { text: "Trading rules satisfied" }
          ],
          rows: [
            [{ text: "Area habitats" }, { text: "" }, { text: "" }, { text: "" }, { text: "" }, { text: "" }, { text: "" }],
            [{ text: "Hedgerows" }, { text: "" }, { text: "" }, { text: "" }, { text: "" }, { text: "" }, { text: "" }],
            [{ text: "Watercourses" }, { text: "" }, { text: "" }, { text: "" }, { text: "" }, { text: "" }, { text: "" }]
          ]
        }) }}
      {% else %}
        {{ govukTable({
          head: [
            { text: "Unit type" },
            { text: "Size" },
            { text: "Units" }
          ],
          rows: [
            [{ text: "Area habitats" }, { text: totalSizes.areaHabitats }, { text: totalUnits.areaHabitats }],
            [{ text: "Hedgerows" }, { text: totalSizes.hedgerows }, { text: totalUnits.hedgerows }],
            [{ text: "Watercourses" }, { text: totalSizes.watercourses }, { text: totalUnits.watercourses }]
          ]
        }) }}
      {% endif %}
    </div>
    <div class="govuk-grid-column-full">
      <h2 class="govuk-heading-m">Habitat details</h2>

      {% set habitats %}
      <h2 class="govuk-heading-m">
        Area habitats
      </h2>
      <table class="govuk-table" data-module="moj-sortable-table">
        <thead class="govuk-table__head">
          <tr class="govuk-table__row">
            <th class="govuk-table__header" scope="col" aria-sort="ascending">Ref</th>
            <th class="govuk-table__header" scope="col" aria-sort="none">Habitat type</th>
            <th class="govuk-table__header" scope="col" aria-sort="none">Area</th>
            <th class="govuk-table__header" scope="col" aria-sort="none">Distinctiveness</th>
            <th class="govuk-table__header" scope="col" aria-sort="none">Condition</th>
            <th class="govuk-table__header" scope="col" aria-sort="none">Units</th>
            <th class="govuk-table__header" scope="col" aria-sort="none">Status</th>
          </tr>
        </thead>
        <tbody class="govuk-table__body">
          {% for row in habitatRows %}
            <tr class="govuk-table__row">
              {% for cell in row %}<td class="govuk-table__cell"{% for attr, val in cell.attributes %} {{ attr | escape }}="{{ val | escape }}"{% endfor %}>{{ cell.html | safe if cell.html else cell.text }}</td>{% endfor %}
            </tr>
          {% endfor %}
        </tbody>
        <tfoot class="govuk-table__foot">
          <tr class="govuk-table__row">
            <td class="govuk-table__cell govuk-!-font-weight-bold">Total</td>
            <td class="govuk-table__cell"></td>
            <td class="govuk-table__cell govuk-!-font-weight-bold">{{ totalSizes.areaHabitats }}</td>
            <td class="govuk-table__cell"></td>
            <td class="govuk-table__cell"></td>
            <td class="govuk-table__cell govuk-!-font-weight-bold">{{ totalUnits.areaHabitats }}</td>
            <td class="govuk-table__cell"></td>
          </tr>
        </tfoot>
      </table>
      {% endset -%}

      {% set hedgerows %}
      <h2 class="govuk-heading-m">
        Hedgerows
      </h2>
      {% if hedgerowRows %}
        <table class="govuk-table" data-module="moj-sortable-table">
          <thead class="govuk-table__head">
            <tr class="govuk-table__row">
              <th class="govuk-table__header" scope="col" aria-sort="ascending">Ref</th>
              <th class="govuk-table__header" scope="col" aria-sort="none">Habitat type</th>
              <th class="govuk-table__header" scope="col" aria-sort="none">Length</th>
              <th class="govuk-table__header" scope="col" aria-sort="none">Distinctiveness</th>
              <th class="govuk-table__header" scope="col" aria-sort="none">Condition</th>
              <th class="govuk-table__header" scope="col" aria-sort="none">Units</th>
              <th class="govuk-table__header" scope="col" aria-sort="none">Status</th>
            </tr>
          </thead>
          <tbody class="govuk-table__body">
            {% for row in hedgerowRows %}
              <tr class="govuk-table__row">
                {% for cell in row %}<td class="govuk-table__cell"{% for attr, val in cell.attributes %} {{ attr | escape }}="{{ val | escape }}"{% endfor %}>{{ cell.html | safe if cell.html else cell.text }}</td>{% endfor %}
              </tr>
            {% endfor %}
          </tbody>
          <tfoot class="govuk-table__foot">
            <tr class="govuk-table__row">
              <td class="govuk-table__cell govuk-!-font-weight-bold">Total</td>
              <td class="govuk-table__cell"></td>
              <td class="govuk-table__cell govuk-!-font-weight-bold">{{ totalSizes.hedgerows }}</td>
              <td class="govuk-table__cell"></td>
              <td class="govuk-table__cell"></td>
              <td class="govuk-table__cell govuk-!-font-weight-bold">{{ totalUnits.hedgerows }}</td>
              <td class="govuk-table__cell"></td>
            </tr>
          </tfoot>
        </table>
      {% else %}
        <p class="govuk-body">No hedgerow data uploaded.</p>
      {% endif %}
      {% endset -%}

      {% set watercourses %}
      <h2 class="govuk-heading-m">
        Watercourses
      </h2>
      {% if watercourseRows %}
        <table class="govuk-table" data-module="moj-sortable-table">
          <thead class="govuk-table__head">
            <tr class="govuk-table__row">
              <th class="govuk-table__header" scope="col" aria-sort="ascending">Ref</th>
              <th class="govuk-table__header" scope="col" aria-sort="none">Habitat type</th>
              <th class="govuk-table__header" scope="col" aria-sort="none">Size</th>
              <th class="govuk-table__header" scope="col" aria-sort="none">Distinctiveness</th>
              <th class="govuk-table__header" scope="col" aria-sort="none">Condition</th>
              <th class="govuk-table__header" scope="col" aria-sort="none">Units</th>
              <th class="govuk-table__header" scope="col" aria-sort="none">Status</th>
            </tr>
          </thead>
          <tbody class="govuk-table__body">
            {% for row in watercourseRows %}
              <tr class="govuk-table__row">
                {% for cell in row %}<td class="govuk-table__cell"{% for attr, val in cell.attributes %} {{ attr | escape }}="{{ val | escape }}"{% endfor %}>{{ cell.html | safe if cell.html else cell.text }}</td>{% endfor %}
              </tr>
            {% endfor %}
          </tbody>
          <tfoot class="govuk-table__foot">
            <tr class="govuk-table__row">
              <td class="govuk-table__cell govuk-!-font-weight-bold">Total</td>
              <td class="govuk-table__cell"></td>
              <td class="govuk-table__cell govuk-!-font-weight-bold">{{ totalSizes.watercourses }}</td>
              <td class="govuk-table__cell"></td>
              <td class="govuk-table__cell"></td>
              <td class="govuk-table__cell govuk-!-font-weight-bold">{{ totalUnits.watercourses }}</td>
              <td class="govuk-table__cell"></td>
            </tr>
          </tfoot>
        </table>
      {% else %}
        <p class="govuk-body">No watercourse data uploaded.</p>
      {% endif %}
      {% endset -%}

      {{ govukTabs({
        items: [
          {
            label: "Areas",
            id: "area-habitats",
            panel: { html: habitats }
          },
          {
            label: "Hedgerows",
            id: "hedgerows",
            panel: { html: hedgerows }
          },
          {
            label: "Watercourses",
            id: "watercourses",
            panel: { html: watercourses }
          }
        ]
      }) }}
    </div>
    <div class="govuk-grid-column-full">
      {{ govukButton({
        text: "Continue",
        href: "#",
        classes: "govuk-!-margin-right-2"
      }) }}

      {{ govukButton({
        text: "Upload a different file",
        classes: "govuk-button--secondary",
        href: uploadDifferentHref
      }) }}
    </div>
  </div>
{% endblock %}
