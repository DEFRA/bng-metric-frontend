{% extends 'layouts/page.njk' %}

{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/date-input/macro.njk" import govukDateInput %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}
{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/select/macro.njk" import govukSelect %}
{% from "project-navigation/macro.njk" import appProjectNavigation %}

{% set containerClasses = "app-width-container--wide" %}

{% macro textInput(name, label, maxlength) %}
  {{ govukInput({
    id: name,
    name: name,
    classes: "govuk-input--width-20",
    label: { text: label, classes: "govuk-label--s" },
    value: values[name],
    attributes: { maxlength: maxlength },
    errorMessage: { text: fieldErrors[name] } if fieldErrors[name] else undefined
  }) }}
{% endmacro %}

{% block content %}
  <div class="govuk-grid-row app-project-summary-layout">
    <div class="app-grid-column-one-sixth">
      {{ appProjectNavigation({
        label: heading,
        items: navigationItems
      }) }}
    </div>

    <div class="app-grid-column-five-sixths">
      <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
          {% if errors | length %}
            {{ govukErrorSummary({
              titleText: errorSummaryTitle,
              errorList: errors
            }) }}
          {% endif %}

          <h1 class="govuk-heading-xl">{{ heading }}</h1>

          <p class="govuk-body">
            Enter the details for the project. You do not need to add them all
            straight away, but you will need to complete all of these details
            before you can export your metric.
          </p>

          {% call appForm({ action: formAction }) %}
            <input type="hidden" name="returnUrl" value="{{ returnUrl }}">

            {{ textInput("projectName", "Project name", maxLengths.projectName) }}

            {{ textInput("surveyCompleters", "Survey completed by", maxLengths.personName) }}

            {{ govukDateInput({
              id: "surveyCompletionDate",
              namePrefix: "surveyCompletionDate",
              fieldset: {
                legend: { text: "Survey date", classes: "govuk-fieldset__legend--s" }
              },
              errorMessage: { text: fieldErrors.surveyCompletionDate } if fieldErrors.surveyCompletionDate else undefined,
              items: [
                {
                  name: "day",
                  classes: "govuk-input--width-2" + (" govuk-input--error" if "day" in surveyCompletionDateErrorParts else ""),
                  value: surveyCompletionDate.day,
                  attributes: { maxlength: 2 }
                },
                {
                  name: "month",
                  classes: "govuk-input--width-2" + (" govuk-input--error" if "month" in surveyCompletionDateErrorParts else ""),
                  value: surveyCompletionDate.month,
                  attributes: { maxlength: 2 }
                },
                {
                  name: "year",
                  classes: "govuk-input--width-4" + (" govuk-input--error" if "year" in surveyCompletionDateErrorParts else ""),
                  value: surveyCompletionDate.year,
                  attributes: { maxlength: 4 }
                }
              ]
            }) }}

            {{ textInput("applicant", "Planning permission applicant name", maxLengths.personName) }}

            {% if values.localPlanningAuthority and not values.localPlanningAuthorityReference %}
              <p class="govuk-body">Previously saved local planning authority: {{ values.localPlanningAuthority }}. Choose an authority from the list to update it.</p>
            {% endif %}
            {{ govukSelect({
              id: "localPlanningAuthorityReference",
              name: "localPlanningAuthorityReference",
              label: { text: "Local planning authority", classes: "govuk-label--s" },
              items: localPlanningAuthorityItems,
              errorMessage: { text: fieldErrors.localPlanningAuthorityReference } if fieldErrors.localPlanningAuthorityReference else undefined
            }) }}

            {{ textInput("planningApplicationReference", "Planning application reference (optional)", maxLengths.planningApplicationReference) }}

            {{ textInput("planningApplicationType", "Planning application type (optional)", maxLengths.planningApplicationType) }}

            <div class="govuk-button-group">
              {{ govukButton({ text: "Save" }) }}
              <a class="govuk-link" href="{{ returnUrl }}">Cancel</a>
            </div>
          {% endcall %}
        </div>
      </div>
    </div>
  </div>
{% endblock %}
