{% extends 'layouts/page.njk' %}

{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}
{% from "govuk/components/button/macro.njk" import govukButton %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {% if singleError %}
        <h1 class="govuk-heading-l">{{ singleError.h1 }}</h1>
        {% if singleError.subheading %}
          <h2 class="govuk-heading-m">{{ singleError.subheading }}</h2>
        {% endif %}

        {% if singleError.variant == 'metric-tool' %}
          <p class="govuk-body">
            {% if singleError.opensInNewTab === false %}
              {{ singleError.helpTextBefore }}<a class="govuk-link" href="{{ singleError.linkHref }}">{{ singleError.linkText }}</a>{{ singleError.helpTextAfter }}
            {% else %}
              {{ singleError.helpTextBefore }}<a class="govuk-link" href="{{ singleError.linkHref }}" target="_blank" rel="noreferrer noopener">{{ singleError.linkText }} {{ page.opensInNewTab }}</a>{{ singleError.helpTextAfter }}
            {% endif %}
          </p>
        {% elif singleError.variant == 'placeholder' or singleError.variant == 'text' %}
          <p class="govuk-body">{{ singleError.helpText }}</p>
        {% else %}
          <p class="govuk-body">
            {{ singleError.messageBefore }}{% if singleError.uploadHref %}<a class="govuk-link" href="{{ singleError.uploadHref }}">{{ singleError.linkText }}</a>{{ singleError.messageAfter }}{% endif %}
          </p>
        {% endif %}
      {% elif errorList and errorList.length > 0 %}
        {{ govukErrorSummary({
          titleText: page.summaryTitle,
          errorList: errorList
        }) }}

        <h1 class="govuk-heading-l">{{ page.listHeading }}</h1>

        <p class="govuk-body">{{ page.listIntro }}</p>

        {#
          Interim layout. The final formatting will be finalized in future stories.
        #}
        {% for block in errorBlocks %}
          <h2 class="govuk-heading-m">{{ block.heading }}</h2>
          {% if block.note %}
            <p class="govuk-body">{{ block.note }}</p>
          {% endif %}
          {% if block.items.length > 0 %}
            <ul class="govuk-list">
              {% for item in block.items %}
                <li>{{ item }}</li>
              {% endfor %}
              {% if block.more > 0 %}
                <li class="govuk-hint">{{ page.more(block.more) }}</li>
              {% endif %}
            </ul>
          {% endif %}
        {% endfor %}
      {% else %}
        <h1 class="govuk-heading-l">{{ page.noErrorsHeading }}</h1>
        <p class="govuk-body">{{ page.noErrorsBody }}</p>
      {% endif %}

      {#
        A single error with its own upload link says what to do in the sentence,
        and a metric-tool page has nothing to upload. Plain text copy has
        neither, so it keeps the way back to uploading.
      #}
      {% if not singleError or singleError.variant == 'text' %}
        <div class="govuk-button-group govuk-!-margin-top-6">
          {% if projectId %}
            {{ govukButton({
              text: page.uploadButton,
              href: uploadHref
            }) }}
            <a class="govuk-link" href="/projects/{{ projectId }}/project-summary">{{ page.backToProject }}</a>
          {% else %}
            <a class="govuk-link" href="/">{{ page.backToStart }}</a>
          {% endif %}
        </div>
      {% endif %}
    </div>
  </div>
{% endblock %}
