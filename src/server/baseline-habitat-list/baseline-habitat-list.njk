{% extends 'layouts/page.njk' %}

{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
{% from "govuk/components/tabs/macro.njk" import govukTabs %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/table/macro.njk" import govukTable %}

{% block beforeContent %}
  {{ super() }}
  {{ govukBackLink({
    text: "Back",
    href: "/add-project-details/" + projectId
  }) }}
{% endblock %}

{% block content %}
  {{ appHeading({
    text: heading,
    caption: caption
  }) }}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
      <h2 class="govuk-heading-m">Summary</h2>

      {{ govukTable({
        head: [
          { text: "Unit type" },
          { text: "Size" },
          { text: "Units" }
        ],
        rows: [
          [{ text: "Area habitats" }, { text: totalSizes.areaHabitats }, { text: totalUnits.areaHabitats }],
          [{ text: "Hedgerows" }, { text: totalSizes.hedgerows }, { text: totalUnits.hedgerows }],
          [{ text: "Watercourses" }, { text: totalSizes.watercourses }, { text: totalUnits.watercourses }]
        ]
      }) }}
    </div>
    <div class="govuk-grid-column-full">
      <h2 class="govuk-heading-m">Habitat details</h2>

      {% set habitats %}
      <h2 class="govuk-heading-m">
        Area habitats
      </h2>
      {{ govukTable({
          attributes: {
            "data-module": "moj-sortable-table"
          },
          head: [
            {
              text: "Ref",
              attributes: {
                "aria-sort": "ascending"
              }
            },
            {
              text: "Habitat type",
              attributes: {
                "aria-sort": "none"
              }
            },
            {
              text: "Area (ha)",
              attributes: {
                "aria-sort": "none"
              }
            },
            {
              text: "Distinctiveness",
              attributes: {
                "aria-sort": "none"
              }
            },
            {
              text: "Condition",
              attributes: {
                "aria-sort": "none"
              }
            },
            {
              text: "Units",
              attributes: {
                "aria-sort": "none"
              }
            },
            {
              text: "Status",
              attributes: {
                "aria-sort": "none"
              }
            }
          ],
          rows: habitatRows
        }) -}}
      {% endset -%}

      {% set hedgerows %}
      <h2 class="govuk-heading-m">
        Hedgerows
      </h2>
      {{ govukTable({
          attributes: {
            "data-module": "moj-sortable-table"
          },
          head: [
            {
              text: "Ref",
              attributes: {
                "aria-sort": "ascending"
              }
            },
            {
              text: "Habitat type",
              attributes: {
                "aria-sort": "none"
              }
            },
            {
              text: "Length (km)",
              attributes: {
                "aria-sort": "none"
              }
            },
            {
              text: "Distinctiveness",
              attributes: {
                "aria-sort": "none"
              }
            },
            {
              text: "Condition",
              attributes: {
                "aria-sort": "none"
              }
            },
            {
              text: "Units",
              attributes: {
                "aria-sort": "none"
              }
            },
            {
              text: "Status",
              attributes: {
                "aria-sort": "none"
              }
            }
          ],
          rows: hedgerowRows
        }) -}}
      {% endset -%}

      {% set watercoureRows %}
      <h2 class="govuk-heading-m">
        Watercourses
      </h2>
      {{ govukTable({
          attributes: {
            "data-module": "moj-sortable-table"
          },
          head: [
            {
              text: "Ref",
              attributes: {
                "aria-sort": "ascending"
              }
            },
            {
              text: "Habitat type",
              attributes: {
                "aria-sort": "none"
              }
            },
            {
              text: "Size",
              attributes: {
                "aria-sort": "none"
              }
            },
            {
              text: "Distinctiveness",
              attributes: {
                "aria-sort": "none"
              }
            },
            {
              text: "Condition",
              attributes: {
                "aria-sort": "none"
              }
            },
            {
              text: "Units",
              attributes: {
                "aria-sort": "none"
              }
            },
            {
              text: "Status",
              attributes: {
                "aria-sort": "none"
              }
            }
          ],
          rows: watercourseRows
        }) -}}
      {% endset -%}

      {{ govukTabs({
        items: [
          {
            label: "Areas",
            id: "area-habitats",
            panel: { html: habitats }
          },
          {
            label: "Hedgerows",
            id: "hedgerows",
            panel: { html: hedgerows }
          },
          {
            label: "Watercourses",
            id: "watercourses",
            panel: { html: watercoureRows }
          }
        ]
      }) }}
    </div>
    <div class="govuk-grid-column-full">
      {{ govukButton({
        text: "Continue",
        href: "#",
        classes: "govuk-!-margin-right-2"
      }) }}

      {{ govukButton({
        text: "Upload a different file",
        classes: "govuk-button--secondary",
        href: "/projects/" + projectId + "/upload-baseline-file"
      }) }}
    </div>
  </div>
{% endblock %}