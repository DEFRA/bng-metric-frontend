{% extends 'layouts/page.njk' %}

{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}
{% from "govuk/components/button/macro.njk" import govukButton %}

{% block pageTitle %}{{ serviceName }} - {{ pageTitle }}{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {% if baselineErrors and baselineErrors.length > 0 %}
        {% set errorList = [] %}
        {% for err in baselineErrors %}
          {% set errorList = (errorList.push({ text: err.message, href: "#error-" + loop.index }), errorList) %}
        {% endfor %}

        {{ govukErrorSummary({
          titleText: "There is a problem with your file",
          errorList: errorList
        }) }}

        <h1 class="govuk-heading-l">We couldn't accept your baseline file</h1>

        <p class="govuk-body">
          Your file passed the format check, but failed one or more geometry
          checks. Fix the issues below in your GeoPackage and upload it again.
        </p>

        {% for err in baselineErrors %}
          <h2 class="govuk-heading-m" id="error-{{ loop.index }}">{{ err.message }}</h2>

          {% if err.offendingFeatures and err.offendingFeatures.length > 0 %}
            <p class="govuk-body">Affected features:</p>
            <ul class="govuk-list govuk-list--bullet">
              {% for feature in err.offendingFeatures %}
                <li>
                  {% if feature.name %}
                    {{ feature.name }} (id: {{ feature.id }})
                  {% elif feature.id is defined %}
                    Feature {{ feature.id }}
                  {% elif feature.area is defined %}
                    Sliver #{{ feature.id }} — {{ feature.area }} sq m
                  {% else %}
                    {{ feature | dump }}
                  {% endif %}
                </li>
              {% endfor %}
            </ul>
          {% endif %}
        {% endfor %}
      {% else %}
        <h1 class="govuk-heading-l">There is a problem with your file</h1>
        <p class="govuk-body">
          We couldn't accept your file. Please try again.
        </p>
      {% endif %}

      <div class="govuk-button-group govuk-!-margin-top-6">
        {% if projectId %}
          {{ govukButton({
            text: "Upload a different file",
            href: "/projects/" + projectId + "/upload-baseline-file"
          }) }}
          <a class="govuk-link" href="/projects/{{ projectId }}">Back to project</a>
        {% else %}
          <a class="govuk-link" href="/">Back to start</a>
        {% endif %}
      </div>
    </div>
  </div>
{% endblock %}
