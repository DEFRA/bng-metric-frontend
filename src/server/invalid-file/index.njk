{% extends 'layouts/page.njk' %}

{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}
{% from "govuk/components/button/macro.njk" import govukButton %}

{% block pageTitle %}{{ serviceName }} - {{ pageTitle }}{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {% if errorList and errorList.length > 0 %}
        {{ govukErrorSummary({
          titleText: "There is a problem with your file",
          errorList: errorList
        }) }}

        <h1 class="govuk-heading-l">We couldn't accept your baseline file</h1>

        <p class="govuk-body">
          Your file passed the format check, but failed one or more geometry
          checks. Fix the issues listed above in your GeoPackage and upload it again.
        </p>
      {% else %}
        <h1 class="govuk-heading-l">There is a problem with your file</h1>
        <p class="govuk-body">
          We couldn't accept your file. Please try again.
        </p>
      {% endif %}

      <div class="govuk-button-group govuk-!-margin-top-6">
        {% if projectId %}
          {{ govukButton({
            text: "Upload a different file",
            href: "/projects/" + projectId + "/upload-baseline-file"
          }) }}
          <a class="govuk-link" href="/project-task-list/{{ projectId }}">Back to project</a>
        {% else %}
          <a class="govuk-link" href="/">Back to start</a>
        {% endif %}
      </div>
    </div>
  </div>
{% endblock %}
