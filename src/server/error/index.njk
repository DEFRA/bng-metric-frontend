{% extends 'layouts/page.njk' %}

{% from "error-text-body/macro.njk" import appErrorTextBody %}

{% block content %}
  {{ appHeading({
    text: heading
  }) }}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <p>{{ message }}</p>
      {{ appErrorTextBody({ lines: body }) }}
    </div>
  </div>
{% endblock %}
