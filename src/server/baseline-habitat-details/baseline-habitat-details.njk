{% extends 'layouts/page.njk' %}

{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/select/macro.njk" import govukSelect %}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}

{% block beforeContent %}
  {{ super() }}
  {{ govukBackLink({
    text: "Back",
    href: backHref
  }) }}
{% endblock %}

{% block content %}
  {{ appHeading({
    text: heading,
    caption: caption
  }) }}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <h2 class="govuk-heading-m">Baseline Details</h2>

      {{ govukSummaryList({
        rows: [
          {
            key: { text: "Reference" },
            value: { text: habitatRef }
          },
          {
            key: { text: "Area (hectares)" },
            value: { text: areaDisplay }
          }
        ]
      }) }}

      {{ govukSelect({
        id: "broadHabitat",
        name: "broadHabitat",
        label: { text: "Broad habitat" },
        items: broadHabitatOptions
      }) }}

      {{ govukSelect({
        id: "habitatType",
        name: "habitatType",
        label: { text: "Habitat type" },
        items: habitatTypeOptions
      }) }}

      {{ govukSummaryList({
        rows: [
          {
            key: { text: "Distinctiveness" },
            value: { text: distinctivenessDisplay }
          }
        ]
      }) }}

      {{ govukSelect({
        id: "condition",
        name: "condition",
        label: { text: "Condition" },
        items: conditionOptions
      }) }}

      {{ govukSummaryList({
        rows: [
          {
            key: { text: "Strategic Significance" },
            value: { text: strategicSignificanceDisplay }
          },
          {
            key: { text: "Trading rules" },
            value: { text: tradingRule }
          },
          {
            key: { text: "Habitat units" },
            value: { text: habitatUnitsDisplay }
          }
        ]
      }) }}

      <div class="govuk-button-group">
        {{ govukButton({
          text: "Save",
          type: "button"
        }) }}

        <a class="govuk-link" href="{{ cancelHref }}">Cancel</a>
      </div>
    </div>
  </div>
{% endblock %}
