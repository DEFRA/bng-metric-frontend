{% extends "govuk/template.njk" %}

{# Import GOVUK components globally #}
{% from "govuk/components/breadcrumbs/macro.njk" import govukBreadcrumbs %}
{% from "govuk/components/phase-banner/macro.njk" import govukPhaseBanner %}
{% from "govuk/components/service-navigation/macro.njk" import govukServiceNavigation %}

{# Import custom components globally #}
{% from "heading/macro.njk" import appHeading %}
{% from "form/macro.njk" import appForm with context %}

{% set mainClasses = "app-main-wrapper" %}

{% block head %}
  <meta name="csrf-token" content="{{ crumb }}">
  <link href="{{ getAssetPath('stylesheets/application.scss') }}" rel="stylesheet">
{% endblock %}

{# Override the header/serviceNav sub-blocks rather than the outer `header`
   block itself, so the parent govuk/template.njk still wraps this content in
   its <header> landmark. #}
{% block govukHeader %}
  {{ govukHeader({
    homepageUrl: "https://www.gov.uk/",
    classes: "app-header",
    containerClasses: "govuk-width-container"
  }) }}
{% endblock %}

{% block govukServiceNavigation %}
  {% set navItems = [] %}
  {% if isAuthenticated %}
    {% set navItems = navigation %}
    {% if canSelectDifferentOrganisation %}
      {% set navItems = navItems.concat([{
        text: "Change organisation",
        href: "/auth/login?forceReselection=true",
        current: false
      }]) %}
    {% endif %}
    {% set navItems = navItems.concat([{
      text: "Sign out",
      href: "/auth/logout",
      current: false
    }]) %}
  {% endif %}

  {{ govukServiceNavigation({
    serviceName: serviceName,
    serviceUrl: serviceUrl,
    navigation: navItems
  }) }}
{% endblock %}

{% block pageTitle %}
  {{ pageTitle }} - {{ serviceName }}
{% endblock %}

{% block beforeContent %}
  {# This renders outside <main>, matching the GOV.UK Design System page
     template. Wrapped in its own landmark so it isn't orphaned outside all
     of header/main/footer for assistive tech. #}
  <div role="region" aria-label="Page information">
    {{ govukPhaseBanner({
      tag: {
        text: "Beta"
      },
      html: 'This is a new service. Help us improve it and give your feedback (opens in a new tab).'
    }) }}
    {% if breadcrumbs.length > 1 %}
      {{ govukBreadcrumbs({
        items: breadcrumbs
      }) }}
    {% endif %}
  </div>
{% endblock %}

{% block content %}{% endblock %}

{# Override the govukFooter sub-block rather than the outer `footer` block
   itself, so the parent govuk/template.njk still wraps this content in its
   <footer> landmark. #}
{% block govukFooter %}
  {{ govukFooter({
    meta: {
      items: [
        {
          href: "https://www.gov.uk/help/privacy-notice",
          text: "Privacy"
        },
        {
          href: "https://www.gov.uk/help/cookies",
          text: "Cookies"
        },
        {
          href: "https://www.gov.uk/help/accessibility-statement",
          text: "Accessibility statement"
        }
      ]
    }
  }) }}
{% endblock %}

{% block bodyEnd %}
  <script type="module" src="{{ getAssetPath('application.js') }}"></script>
{% endblock %}
