{% extends 'layouts/page.njk' %}

{# Shared chrome for the stacked post-intervention details pages: Retained,
   Created and Enhanced area habitats, hedgerows and watercourses.

   Fields are stacked: bold label on one line, value on the next — not a
   two-column summary list. No separators between fields. Only the units
   summary uses matching top and bottom borders with label left and value
   right (via .app-units-delivered).

   Each child template sets `sections` — an array of
   { heading, rows: [{ label, value, when?, multiline? }], showBaselineLink? }
   — plus habitatUnitsLabel and habitatUnitsDisplay. A row with a `when` shows
   only when it is true: the area pages' tree rows show on a tree's page alone.
   A `multiline` row keeps the line breaks in its value and wraps long words,
   as free text such as a Retained habitat's supporting information needs
   (BMD-1187).

   Every value is read-only, except on a Retained habitat, whose view model
   carries `refForm` (BMD-1180): the page is then a form, with the "Habitat
   reference" input first in the first section and Save / Cancel below the
   units. The input is the shared habitat-ref-input component, fed by
   `habitatRefInput`; a refused save sets `errors` for the error summary. #}

{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}
{% from "habitat-ref-input/macro.njk" import appHabitatRefInput %}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}

{% block beforeContent %}
  {{ super() }}
  {{ govukBackLink({
    text: "Back",
    href: backHref
  }) }}
{% endblock %}

{% block content %}
  {% if errors | length %}
    {{ govukErrorSummary({
      titleText: errorSummaryTitle,
      errorList: errors
    }) }}
  {% endif %}

  {{ appHeading({
    text: heading,
    caption: caption
  }) }}

  {% set details %}
    {% for section in sections %}
      <h2 class="govuk-heading-m">{{ section.heading }}</h2>

      <div class="app-stacked-fields">
        {% if loop.first and refForm %}
          {{ appHabitatRefInput(habitatRefInput) }}
        {% endif %}

        {% for row in section.rows %}
          {% if not ('when' in row) or row.when %}
          <div class="app-stacked-fields__item">
            {# govuk-heading-s keeps GDS Transport (same as summary-list keys) #}
            <h3 class="govuk-heading-s govuk-!-margin-bottom-1">{{ row.label }}</h3>
            {# The value sits flush against the tags: a multiline row shows
               any whitespace here. #}
            <p class="govuk-body{% if row.multiline %} app-stacked-fields__value--multiline{% endif %}">{{ row.value }}</p>
          </div>
          {% endif %}
        {% endfor %}
      </div>

      {# Below Strategic significance (end of first section), before Time to target #}
      {% if loop.first and viewBaselineHref %}
        <p class="govuk-body">
          <a class="govuk-link" href="{{ viewBaselineHref }}">View baseline details</a>
        </p>
      {% endif %}
    {% endfor %}

    {# Two-column label | value with top/bottom lines — matches the design
       image for Habitat units delivered only. #}
    {{ govukSummaryList({
      classes: "app-units-delivered govuk-!-margin-top-6",
      rows: [
        {
          key: { text: habitatUnitsLabel },
          value: { text: habitatUnitsDisplay }
        }
      ]
    }) }}
  {% endset %}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {% if refForm %}
        {% call appForm({
          action: refForm.action,
          id: "habitat-details-form"
        }) %}
          <input type="hidden" name="projectId" value="{{ refForm.projectId }}">
          <input type="hidden" name="featureId" value="{{ refForm.featureId }}">
          <input type="hidden" name="returnUrl" value="{{ refForm.returnUrl }}">

          {{ details | safe }}

          <div class="govuk-button-group">
            {{ govukButton({
              text: "Save"
            }) }}

            <a class="govuk-link" href="{{ refForm.cancelHref }}">Cancel</a>
          </div>
        {% endcall %}
      {% else %}
        {{ details | safe }}
      {% endif %}
    </div>
  </div>
{% endblock %}
