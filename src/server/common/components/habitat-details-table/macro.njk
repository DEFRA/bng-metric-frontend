{#- A cut-short cell (cell.truncated) shows its first characters and an
    ellipsis, keeps the rest visually hidden so assistive technology hears the
    whole value, and hides the ellipsis from it. -#}
{% macro habitatDetailsCellContent(cell) -%}
  {%- if cell.truncated -%}
    <span>{{ cell.truncated.shown }}</span><span class="govuk-visually-hidden">{{ cell.truncated.hidden }}</span><span aria-hidden="true">{{ cell.truncated.mark }}</span>
  {%- else -%}
    {{ cell.text }}
  {%- endif -%}
{%- endmacro %}

{% macro habitatDetailsCell(cell) -%}
  <td class="govuk-table__cell{% if cell.numeric %} govuk-table__cell--numeric{% endif %}{% if cell.classes %} {{ cell.classes }}{% endif %}"{% if cell.attributes %}{% for attr, val in cell.attributes %} {{ attr | escape }}="{{ val | escape }}"{% endfor %}{% endif %}>{% if cell.href %}<a class="govuk-link" href="{{ cell.href }}">{{ habitatDetailsCellContent(cell) }}</a>{% else %}{{ habitatDetailsCellContent(cell) }}{% endif %}</td>
{%- endmacro %}

{% macro appHabitatDetailsTable(params) %}
  <div class="moj-scrollable-pane" role="region" aria-label="{{ params.regionLabel }}" tabindex="0">
    <table class="govuk-table app-habitat-details-table" data-module="moj-sortable-table">
      <thead class="govuk-table__head">
        <tr class="govuk-table__row">
          {% for column in params.columns %}
            <th class="govuk-table__header{% if column.numeric %} govuk-table__header--numeric{% endif %}" scope="col" aria-sort="none">{{ column.text }}</th>
          {% endfor %}
        </tr>
      </thead>
      <tbody class="govuk-table__body">
        {% for row in params.habitatRows %}
          <tr class="govuk-table__row">
            {% for cell in row %}{{ habitatDetailsCell(cell) }}{% endfor %}
          </tr>
        {% endfor %}
      </tbody>
      <tfoot class="govuk-table__foot">
        <tr class="govuk-table__row">
          {% for cell in params.totalsRow %}{{ habitatDetailsCell(cell) }}{% endfor %}
        </tr>
      </tfoot>
    </table>
  </div>
{% endmacro %}
