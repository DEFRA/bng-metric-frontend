{% extends 'layouts/page.njk' %}

{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/table/macro.njk" import govukTable %}
{% from "project-navigation/macro.njk" import appProjectNavigation %}
{% from "unit-type-summary/macro.njk" import appUnitTypeSummary %}

{% set containerClasses = "app-width-container--wide" %}

{% block content %}
  <div class="govuk-grid-row app-project-summary-layout">
    <div class="app-grid-column-one-sixth">
      {{ appProjectNavigation({
        label: "Project summary",
        items: navigationItems
      }) }}
    </div>

    <div class="app-grid-column-five-sixths">
      <div class="app-project-summary__heading">
        <div>
          <span class="govuk-caption-l">{{ projectName }}</span>
          <h1 class="govuk-heading-xl govuk-!-margin-bottom-0">{{ heading }}</h1>
        </div>
        {{ govukButton({
          text: "Upload file",
          href: uploadHref,
          classes: "govuk-!-margin-bottom-0"
        }) }}
      </div>

      {#- No download attribute: the workbook's content-disposition already
          makes the browser save it, and without the attribute an error, such
          as "too many requests", shows as a page, not a failed download. #}
      {% set metricLinks %}
        <a class="govuk-link" href="{{ metricDownloads.xlsmHref }}" data-testid="metric-xlsm-link">Macro enabled (.xlsm)<span class="govuk-visually-hidden"> metric calculation spreadsheet</span></a>
        /
        <a class="govuk-link" href="{{ metricDownloads.xlsxHref }}" data-testid="metric-xlsx-link">Macro disabled (.xlsx)<span class="govuk-visually-hidden"> metric calculation spreadsheet</span></a>
      {% endset %}
      {{ govukTable({
        caption: "Actions",
        captionClasses: "govuk-table__caption--m",
        attributes: { "data-testid": "project-actions" },
        head: [
          { text: "Description" },
          { text: "Link" }
        ],
        rows: [
          [
            { text: "Download metric calculation spreadsheet" },
            { html: metricLinks }
          ]
        ]
      }) }}

      {% for summary in unitSummaries %}
        {{ appUnitTypeSummary(summary) }}
      {% endfor %}
    </div>
  </div>
{% endblock %}
