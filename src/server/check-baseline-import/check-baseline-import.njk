{% extends 'layouts/page.njk' %}

{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% block beforeContent %}
  {{ super() }}
  <nav>
    <a class="govuk-back-link" href="/projects/{{ projectId }}/upload-baseline-file">Back</a>
  </nav>
{% endblock %}

{% set mapPlaceholderHtml %}
  {% include "map/template.njk" %}
{% endset %}

{# Temporary entry point for BMD-315 manual testing. BMD-305 (Habitat List)
   will own the real link in, so this block should be removed when BMD-305
   merges and the Area Habitats row gets its proper summary value. #}
{% set areaHabitatsHtml %}
  {% if habitats and habitats.length %}
    <ul class="govuk-list">
      {% for habitat in habitats %}
        <li>
          <a class="govuk-link" href="/baseline-habitat-details?projectId={{ projectId }}&habitatId={{ habitat.featureId }}">
            {{ habitat.ref }}
          </a>
        </li>
      {% endfor %}
    </ul>
  {% endif %}
{% endset %}

{% block content %}
  {{ appHeading({
    text: heading,
    caption: caption
  }) }}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {{ govukSummaryList({
        card: {
          title: { text: "Site Details" }
        },
        rows: [
          {
            key: { text: "Red Line Boundary" },
            value: { text: "" }
          },
          {
            key: { text: "Area Habitats" },
            value: { html: areaHabitatsHtml }
          },
          {
            key: { text: "Map View" },
            value: {
              html: mapPlaceholderHtml
            }
          }
        ]
      }) }}

      {{ govukSummaryList({
        card: {
          title: { text: "File Details" }
        },
        rows: [
          {
            key: { text: "File uploaded" },
            value: { text: filename if filename else "" }
          },
          {
            key: { text: "Layers" },
            value: { text: "" }
          }
        ]
      }) }}

      {{ govukButton({
        text: "Upload a different file",
        href: "/projects/" + projectId + "/upload-baseline-file",
        classes: "govuk-button--secondary"
      }) }}
    </div>
  </div>
{% endblock %}
