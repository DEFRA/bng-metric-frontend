{% extends 'layouts/pi-view-only-sections-page.njk' %}

{# View-only page: retained post-intervention area habitat — stacked
   label-over-value layout. The parcel ref is the H1;
   "Post-intervention habitat details" is the single section heading. The
   sections layout renders the "View baseline details" link after the first
   section and the "Habitat units delivered" summary row below it. #}
{% set sections = [
  {
    heading: habitatDetailsSectionHeading,
    rows: [
      { label: "Intervention", value: interventionDisplay },
      { label: "Size (hectares)", value: sizeDisplay },
      { label: "Broad habitat", value: broadHabitatDisplay },
      { label: "Habitat type", value: habitatTypeDisplay },
      { label: "Distinctiveness", value: distinctivenessDisplay },
      { label: "Condition", value: conditionDisplay },
      { label: "Strategic significance", value: strategicSignificanceDisplay }
    ]
  }
] %}
