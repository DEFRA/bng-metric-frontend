{% extends 'layouts/pi-view-only-sections-page.njk' %}

{# Enhanced or Created post-intervention individual tree, in the area habitat
   layout, with the tree's size class and the number of trees the point
   stands for. #}
{% set sections = [
  {
    heading: habitatDetailsSectionHeading,
    rows: [
      { label: "Intervention", value: interventionDisplay },
      { label: sizeLabel or "Area", value: sizeDisplay },
      { label: "Tree size", value: treeSizeDisplay },
      { label: "Number of trees", value: treeCountDisplay },
      { label: "Broad habitat", value: broadHabitatDisplay },
      { label: "Habitat type", value: habitatTypeDisplay },
      { label: "Distinctiveness", value: distinctivenessDisplay },
      { label: "Condition", value: conditionDisplay },
      { label: "Strategic significance", value: strategicSignificanceDisplay }
    ]
  },
  {
    heading: timeDifficultySectionHeading,
    rows: [
      { label: "Target condition", value: targetConditionDisplay },
      { label: "Standard time to target condition", value: standardTimeToTargetDisplay },
      { label: "Standard difficulty", value: standardDifficultyDisplay },
      { label: "Advance or delay?", value: advanceOrDelayDisplay },
      { label: "Final time to target condition", value: finalTimeToTargetDisplay },
      { label: "Applied difficulty multiplier", value: appliedDifficultyMultiplierDisplay }
    ]
  }
] %}
