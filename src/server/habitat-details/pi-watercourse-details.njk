{% extends 'layouts/pi-view-only-sections-page.njk' %}

{# View-only page: retained post-intervention watercourse habitat — stacked
   label-over-value layout. The parcel ref is the H1; "Post-intervention
   habitat details" is the single section heading, and the two encroachment
   rows are what set this page apart from the hedgerow. The sections layout
   renders the "View baseline details" link after the section and the
   "Habitat units delivered" summary row below it. #}
{% set sections = [
  {
    heading: habitatDetailsSectionHeading,
    rows: [
      { label: "Intervention", value: interventionDisplay },
      { label: "Size (kilometres)", value: sizeDisplay },
      { label: "Habitat type", value: habitatTypeDisplay },
      { label: "Distinctiveness", value: distinctivenessDisplay },
      { label: "Condition", value: conditionDisplay },
      { label: "Watercourse encroachment", value: watercourseEncroachmentDisplay },
      { label: "Riparian encroachment", value: riparianEncroachmentDisplay },
      { label: "Strategic significance", value: strategicSignificanceDisplay }
    ]
  }
] %}
