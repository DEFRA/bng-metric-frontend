{% extends 'layouts/page.njk' %}

{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}
{% from "habitat-ref-input/macro.njk" import appHabitatRefInput %}
{% from "govuk/components/select/macro.njk" import govukSelect %}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "govuk/components/textarea/macro.njk" import govukTextarea %}

{% block beforeContent %}
  {{ super() }}
  {{ govukBackLink({
    text: "Back",
    href: backHref
  }) }}
{% endblock %}

{# Stacked "label above the data" layout (BMD-1061): each field is a bold
   label with its value or form control underneath, matching the
   post-intervention details pages (.app-stacked-fields). Only the units row
   keeps label | value between top and bottom rules (.app-units-delivered).

   The reference input, dropdowns and Save button live inside a single
   appForm. Hidden inputs carry projectId and featureId; the macro injects the
   crumb. The client JS reads referenceData below to update the
   distinctiveness / trading-rule / condition values as the user changes
   dropdowns, without mutating saved data.

   Once post-intervention data is uploaded the page is `locked` (BMD-1194):
   every value shows as text under its usual label, the comment in full with
   its line breaks (or "No data"), and there is no form, Save button or
   reference data for the client JS.

   The "Broad habitat" field only renders for area habitats; hedgerows and
   watercourses have no broad habitat dimension. The size field swaps label +
   value between "Size (hectares)" and "Length (km)" via the strategy view
   model. #}
{% macro stackedField(label, value, valueId) %}
  <div class="app-stacked-fields__item">
    <h3 class="govuk-heading-s govuk-!-margin-bottom-1">{{ label }}</h3>
    <p class="govuk-body">
      {%- if valueId -%}
        <span id="{{ valueId }}">{{ value }}</span>
      {%- else -%}
        {{ value }}
      {%- endif -%}
    </p>
  </div>
{% endmacro %}

{% block content %}
  {% if errors | length %}
    {{ govukErrorSummary({
      titleText: errorSummaryTitle,
      errorList: errors
    }) }}
  {% endif %}

  {{ appHeading({
    text: heading,
    caption: caption
  }) }}

  {% set details %}
    {% if not locked %}
      <input type="hidden" name="projectId" value="{{ projectId }}">
      <input type="hidden" name="featureId" value="{{ featureId }}">
      <input type="hidden" name="returnUrl" value="{{ returnUrl }}">

      <script type="application/json" id="bhd-reference-data">{{ referenceJson | safe }}</script>
    {% endif %}

    <div class="app-stacked-fields">
      {% if locked %}
        {{ stackedField("Habitat reference", habitatRef) }}
      {% else %}
        {{ appHabitatRefInput(habitatRefInput) }}
      {% endif %}

      {{ stackedField(sizeLabel, sizeDisplay) }}

      {# An individual tree's size class and number of trees, from which
         its size in hectares comes. #}
      {% if showTreeRows %}
        {{ stackedField("Tree size", treeSizeDisplay) }}
        {{ stackedField("Number of trees", treeCountDisplay) }}
      {% endif %}

      {% if showBroadHabitatRow %}
        {% if locked %}
          {{ stackedField("Broad habitat", broadHabitatDisplay) }}
        {% else %}
          {{ govukSelect({
            id: "broadHabitat",
            name: "broadHabitat",
            label: { text: "Broad habitat", classes: "govuk-label--s" },
            items: broadHabitatOptions,
            formGroup: { classes: "app-stacked-fields__item" }
          }) }}
        {% endif %}
      {% endif %}

      {# An individual tree is always Individual trees: shown, and sent
         with the form under the broad habitat's id and name, so the client
         JS reads it as it reads the dropdown, but not editable (BMD-1172). #}
      {% if fixedBroadHabitat %}
        {{ stackedField("Broad habitat", fixedBroadHabitat) }}
        {% if not locked %}
          <input type="hidden" id="broadHabitat" name="broadHabitat" value="{{ fixedBroadHabitat }}">
        {% endif %}
      {% endif %}

      {% if locked %}
        {{ stackedField("Habitat type", habitatTypeDisplay) }}
      {% else %}
        {{ govukSelect({
          id: "habitatType",
          name: "habitatType",
          label: { text: "Habitat type", classes: "govuk-label--s" },
          items: habitatTypeOptions,
          formGroup: { classes: "app-stacked-fields__item" }
        }) }}
      {% endif %}

      {{ stackedField("Distinctiveness", distinctivenessDisplay, "distinctivenessDisplay") }}

      {% if locked %}
        {{ stackedField("Condition", conditionDisplay) }}
      {% else %}
        {{ govukSelect({
          id: "condition",
          name: "condition",
          label: { text: "Condition", classes: "govuk-label--s" },
          items: conditionOptions,
          formGroup: { classes: "app-stacked-fields__item" }
        }) }}
      {% endif %}

      {# Watercourse-only fields: the riparian/watercourse encroachment
         selections are stored on the feature and editable. Their option
         lists are culvert-aware (culverts show only "N/A - Culvert"; every
         other type excludes it), filtered server-side on load and by the
         client JS on habitat-type change. Saving persists the selections
         and recomputes units via the unified PUT (BMD-597). #}
      {% if showWatercourseEncroachmentRows %}
        {% if locked %}
          {{ stackedField("Watercourse encroachment", watercourseEncroachmentDisplay) }}
          {{ stackedField("Riparian encroachment", riparianEncroachmentDisplay) }}
        {% else %}
          {{ govukSelect({
            id: "watercourseEncroachment",
            name: "watercourseEncroachment",
            label: { text: "Watercourse encroachment", classes: "govuk-label--s" },
            items: watercourseEncroachmentOptions,
            formGroup: { classes: "app-stacked-fields__item" }
          }) }}
          {{ govukSelect({
            id: "riparianEncroachment",
            name: "riparianEncroachment",
            label: { text: "Riparian encroachment", classes: "govuk-label--s" },
            items: riparianEncroachmentOptions,
            formGroup: { classes: "app-stacked-fields__item" }
          }) }}
        {% endif %}
      {% endif %}

      {{ stackedField("Strategic significance", strategicSignificanceDisplay) }}

      {{ stackedField("Required action to meet trading rules", tradingRule, "tradingRuleDisplay") }}
    </div>

    {{ govukSummaryList({
      classes: "app-units-delivered govuk-!-margin-top-6",
      rows: [
        {
          key: { text: "Units in this habitat" },
          value: { text: habitatUnitsDisplay }
        }
      ]
    }) }}

    {# Every baseline feature type offers the box (BMD-1112): areas,
       vertical area habitats, hedgerows, watercourses and individual
       trees. A page that leaves showCommentRow unset submits no comment,
       and buildSaveBody then leaves the stored one alone. Locked, the
       comment is shown in full, line breaks kept, without the hint. #}
    {% if showCommentRow %}
      {% if locked %}
        <h2 class="govuk-heading-m govuk-!-margin-top-6">Supporting information</h2>
        {# The value sits flush against the tags: a multiline value shows
           any whitespace here. #}
        <p class="govuk-body app-stacked-fields__value--multiline">{{ commentDisplay }}</p>
      {% else %}
        {{ govukTextarea({
          id: "comment",
          name: "comment",
          rows: 5,
          label: {
            text: "Supporting information",
            classes: "govuk-label--m"
          },
          hint: {
            text: "Add information to help the Local Planning Authority understand the baseline metric."
          },
          value: commentInput.value,
          errorMessage: commentInput.error,
          classes: "govuk-!-margin-top-6"
        }) }}
      {% endif %}
    {% endif %}
  {% endset %}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <h2 class="govuk-heading-m">{{ detailsSectionHeading }}</h2>

      {% if locked %}
        {{ details | safe }}

        <p class="govuk-body">
          <a class="govuk-link" href="{{ cancelHref }}">Cancel</a>
        </p>
      {% else %}
        {% call appForm({
          action: formAction,
          id: "habitat-details-form"
        }) %}
          {{ details | safe }}

          <div class="govuk-button-group">
            {{ govukButton({
              text: "Save"
            }) }}

            <a class="govuk-link" href="{{ cancelHref }}">Cancel</a>
          </div>
        {% endcall %}
      {% endif %}
    </div>
  </div>
{% endblock %}
