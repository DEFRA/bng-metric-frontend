{% extends 'layouts/page.njk' %}

{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}
{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/select/macro.njk" import govukSelect %}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}

{% block beforeContent %}
  {{ super() }}
  {{ govukBackLink({
    text: "Back",
    href: backHref
  }) }}
{% endblock %}

{# Stacked "label above the data" layout (BMD-1061): each field is a bold
   label with its value or form control underneath, matching the
   post-intervention details pages (.app-stacked-fields). Only the units row
   keeps label | value between top and bottom rules (.app-units-delivered).

   The reference input, dropdowns and Save button live inside a single
   appForm. Hidden inputs carry projectId and featureId; the macro injects the
   crumb. The client JS reads referenceData below to update the
   distinctiveness / trading-rule / condition values as the user changes
   dropdowns, without mutating saved data.

   The "Broad habitat" field only renders for area habitats; hedgerows and
   watercourses have no broad habitat dimension. The size field swaps label +
   value between "Size (hectares)" and "Length (km)" via the strategy view
   model. #}
{% macro stackedField(label, value, valueId) %}
  <div class="app-stacked-fields__item">
    <h3 class="govuk-heading-s govuk-!-margin-bottom-1">{{ label }}</h3>
    <p class="govuk-body">
      {%- if valueId -%}
        <span id="{{ valueId }}">{{ value }}</span>
      {%- else -%}
        {{ value }}
      {%- endif -%}
    </p>
  </div>
{% endmacro %}

{% block content %}
  {% if errors | length %}
    {{ govukErrorSummary({
      titleText: "There is a problem",
      errorList: errors
    }) }}
  {% endif %}

  {{ appHeading({
    text: heading,
    caption: caption
  }) }}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <h2 class="govuk-heading-m">{{ detailsSectionHeading }}</h2>

      {% call appForm({
        action: formAction,
        id: "habitat-details-form"
      }) %}
        <input type="hidden" name="projectId" value="{{ projectId }}">
        <input type="hidden" name="featureId" value="{{ featureId }}">

        <script type="application/json" id="bhd-reference-data">{{ referenceJson | safe }}</script>

        <div class="app-stacked-fields">
          {{ govukInput({
            id: "habitatRef",
            name: "habitatRef",
            label: { text: "Habitat Reference", classes: "govuk-label--s" },
            value: habitatRefValue,
            classes: "govuk-input--width-20",
            spellcheck: false,
            attributes: { maxlength: maxHabitatRefLength },
            errorMessage: habitatRefError,
            formGroup: { classes: "app-stacked-fields__item" }
          }) }}

          {{ stackedField(sizeLabel, sizeDisplay) }}

          {% if showBroadHabitatRow %}
            {{ govukSelect({
              id: "broadHabitat",
              name: "broadHabitat",
              label: { text: "Broad habitat", classes: "govuk-label--s" },
              items: broadHabitatOptions,
              formGroup: { classes: "app-stacked-fields__item" }
            }) }}
          {% endif %}

          {{ govukSelect({
            id: "habitatType",
            name: "habitatType",
            label: { text: "Habitat type", classes: "govuk-label--s" },
            items: habitatTypeOptions,
            formGroup: { classes: "app-stacked-fields__item" }
          }) }}

          {{ stackedField("Distinctiveness", distinctivenessDisplay, "distinctivenessDisplay") }}

          {{ govukSelect({
            id: "condition",
            name: "condition",
            label: { text: "Condition", classes: "govuk-label--s" },
            items: conditionOptions,
            formGroup: { classes: "app-stacked-fields__item" }
          }) }}

          {# Watercourse-only fields: the riparian/watercourse encroachment
             selections are stored on the feature and editable. Their option
             lists are culvert-aware (culverts show only "N/A - Culvert"; every
             other type excludes it), filtered server-side on load and by the
             client JS on habitat-type change. Saving persists the selections
             and recomputes units via the unified PUT (BMD-597). #}
          {% if showWatercourseEncroachmentRows %}
            {{ govukSelect({
              id: "watercourseEncroachment",
              name: "watercourseEncroachment",
              label: { text: "Watercourse encroachment", classes: "govuk-label--s" },
              items: watercourseEncroachmentOptions,
              formGroup: { classes: "app-stacked-fields__item" }
            }) }}
            {{ govukSelect({
              id: "riparianEncroachment",
              name: "riparianEncroachment",
              label: { text: "Riparian encroachment", classes: "govuk-label--s" },
              items: riparianEncroachmentOptions,
              formGroup: { classes: "app-stacked-fields__item" }
            }) }}
          {% endif %}

          {{ stackedField("Strategic significance", strategicSignificanceDisplay) }}

          {{ stackedField("Required action to meet trading rules", tradingRule, "tradingRuleDisplay") }}
        </div>

        {{ govukSummaryList({
          classes: "app-units-delivered govuk-!-margin-top-6",
          rows: [
            {
              key: { text: "Units in this habitat" },
              value: { text: habitatUnitsDisplay }
            }
          ]
        }) }}

        <div class="govuk-button-group">
          {{ govukButton({
            text: "Save"
          }) }}

          <a class="govuk-link" href="{{ cancelHref }}">Cancel</a>
        </div>
      {% endcall %}
    </div>
  </div>
{% endblock %}
