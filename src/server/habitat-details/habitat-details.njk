{% extends 'layouts/page.njk' %}

{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/select/macro.njk" import govukSelect %}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}

{% block beforeContent %}
  {{ super() }}
  {{ govukBackLink({
    text: "Back",
    href: backHref
  }) }}
{% endblock %}

{% block content %}
  {{ appHeading({
    text: heading,
    caption: caption
  }) }}

  {# Two-column layout (label left, value/field right) per Figma. Form fields
     are embedded as `html` cells inside govukSummaryList so they share the
     same row grid as the read-only rows. Each select's visible label is
     hidden — the summary-list key column acts as the label — but the
     accessible label text is preserved for screen readers via the
     govuk-visually-hidden class.

     The dropdowns + Save button live inside a single appForm. Hidden inputs
     carry projectId and featureId; the macro injects the crumb. The client
     Client JS reads referenceData below to update the
     distinctiveness / trading-rule / condition cells as the user changes
     dropdowns, without mutating saved data.

     The "Broad habitat" row only renders for area habitats; hedgerows have
     no broad habitat dimension. The size row swaps label + value between
     "Area (hectares)" and "Length (km)" via the strategy view model. #}
  {% if showBroadHabitatRow %}
    {% set broadHabitatHtml %}
      {{ govukSelect({
        id: "broadHabitat",
        name: "broadHabitat",
        label: { text: "Broad habitat", classes: "govuk-visually-hidden" },
        items: broadHabitatOptions,
        formGroup: { classes: "govuk-!-margin-bottom-0" }
      }) }}
    {% endset %}
  {% endif %}

  {% set habitatTypeHtml %}
    {{ govukSelect({
      id: "habitatType",
      name: "habitatType",
      label: { text: "Habitat type", classes: "govuk-visually-hidden" },
      items: habitatTypeOptions,
      formGroup: { classes: "govuk-!-margin-bottom-0" }
    }) }}
  {% endset %}

  {% set conditionHtml %}
    {{ govukSelect({
      id: "condition",
      name: "condition",
      label: { text: "Condition", classes: "govuk-visually-hidden" },
      items: conditionOptions,
      formGroup: { classes: "govuk-!-margin-bottom-0" }
    }) }}
  {% endset %}

  {# Watercourse-only rows: the riparian/watercourse encroachment selections are
     stored on the feature and editable. Their option lists are culvert-aware
     (culverts show only "N/A - Culvert"; every other type excludes it), filtered
     server-side on load and by the client JS on habitat-type change. Saving
     persists the selections and recomputes units via the unified PUT (BMD-597).
     Changing a value is display-only until Save, matching the condition/type
     dropdowns. #}
  {% if showWatercourseEncroachmentRows %}
    {% set riparianEncroachmentHtml %}
      {{ govukSelect({
        id: "riparianEncroachment",
        name: "riparianEncroachment",
        label: { text: "Riparian encroachment", classes: "govuk-visually-hidden" },
        items: riparianEncroachmentOptions,
        formGroup: { classes: "govuk-!-margin-bottom-0" }
      }) }}
    {% endset %}
    {% set watercourseEncroachmentHtml %}
      {{ govukSelect({
        id: "watercourseEncroachment",
        name: "watercourseEncroachment",
        label: { text: "Watercourse encroachment", classes: "govuk-visually-hidden" },
        items: watercourseEncroachmentOptions,
        formGroup: { classes: "govuk-!-margin-bottom-0" }
      }) }}
    {% endset %}
  {% endif %}

  {% set distinctivenessHtml %}
    <span id="distinctivenessDisplay">{{ distinctivenessDisplay }}</span>
  {% endset %}

  {% set tradingRuleHtml %}
    <span id="tradingRuleDisplay">{{ tradingRule }}</span>
  {% endset %}

  {% set summaryRows = [
    { key: { text: "Reference" }, value: { text: habitatRef } },
    { key: { text: sizeLabel }, value: { text: sizeDisplay } }
  ] %}

  {% if showBroadHabitatRow %}
    {% set summaryRows = (summaryRows.push({ key: { text: "Broad habitat" }, value: { html: broadHabitatHtml } }), summaryRows) %}
  {% endif %}

  {% set summaryRows = (summaryRows.push({ key: { text: "Habitat type" }, value: { html: habitatTypeHtml } }), summaryRows) %}
  {% set summaryRows = (summaryRows.push({ key: { text: "Distinctiveness" }, value: { html: distinctivenessHtml } }), summaryRows) %}
  {% set summaryRows = (summaryRows.push({ key: { text: "Condition" }, value: { html: conditionHtml } }), summaryRows) %}
  {% if showWatercourseEncroachmentRows %}
    {% set summaryRows = (summaryRows.push({ key: { text: "Watercourse encroachment" }, value: { html: watercourseEncroachmentHtml } }), summaryRows) %}
    {% set summaryRows = (summaryRows.push({ key: { text: "Riparian encroachment" }, value: { html: riparianEncroachmentHtml } }), summaryRows) %}
  {% endif %}
  {% set summaryRows = (summaryRows.push({ key: { text: "Strategic Significance" }, value: { text: strategicSignificanceDisplay } }), summaryRows) %}
  {% set summaryRows = (summaryRows.push({ key: { text: "Required action to meet trading rules" }, value: { html: tradingRuleHtml } }), summaryRows) %}
  {% set summaryRows = (summaryRows.push({ key: { text: "Units in this habitat" }, value: { text: habitatUnitsDisplay } }), summaryRows) %}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <h2 class="govuk-heading-m">{{ detailsSectionHeading }}</h2>

      {% call appForm({
        action: formAction,
        id: "habitat-details-form"
      }) %}
        <input type="hidden" name="projectId" value="{{ projectId }}">
        <input type="hidden" name="featureId" value="{{ featureId }}">

        <script type="application/json" id="bhd-reference-data">{{ referenceJson | safe }}</script>

        {{ govukSummaryList({ rows: summaryRows }) }}

        <div class="govuk-button-group">
          {{ govukButton({
            text: "Save"
          }) }}

          <a class="govuk-link" href="{{ cancelHref }}">Cancel</a>
        </div>
      {% endcall %}
    </div>
  </div>
{% endblock %}
