# =============================================================================
# bng-metric-frontend — example environment
#
# Copy to .env and adjust for your machine. The app reads process.env directly
# (via convict); it does NOT auto-load .env, so load it yourself, e.g.:
#   node --env-file=.env .          # Node 20+
#   set -a; . ./.env; set +a        # POSIX shells
#   direnv                          # put the vars in .envrc (also git-ignored)
# For a quick start against the stub you may not even need a .env: `npm run dev`
# already sets the key OIDC_USE_STUB / APP_BASE_URL / CDP_UPLOADER_URL vars.
#
# This file is committed and holds ONLY local/stub placeholders — no real
# secrets. Put real credentials in .env (git-ignored), never here.
# =============================================================================

# ---- Server -----------------------------------------------------------------
PORT=3000                            # Port the frontend binds to
APP_BASE_URL=http://localhost:3000   # Browser-facing base URL (upload callbacks)
LOG_LEVEL=info                       # fatal|error|warn|info|debug|trace|silent

# ---- Backend API ------------------------------------------------------------
BACKEND_URL=http://localhost:3001    # bng-metric-backend base URL

# ---- Authentication: OIDC / Defra Identity ----------------------------------
# Mode switch:
#   true  -> local cdp-defra-id-stub (no nonce; client id NOT appended to scopes)
#   false -> live Defra Identity (Azure AD B2C)
OIDC_USE_STUB=true

# -- Local: cdp-defra-id-stub (these match the stub's defaults) --
OIDC_DISCOVERY_URL=http://localhost:3200/cdp-defra-id-stub/.well-known/openid-configuration
# The stub's built-in, public client identifier — not a credential.
OIDC_CLIENT_ID=63983fc2-cfff-45bb-8ec2-959e21062b9a
# Placeholder only: the stub does not verify the client secret. For B2C, set the
# real value in .env (git-ignored), never here.
OIDC_CLIENT_SECRET=stub-local-placeholder-not-a-real-secret
OIDC_REDIRECT_URI=http://localhost:3000/auth/callback
OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:3000/auth/signed-out
OIDC_SCOPES=openid profile email offline_access
OIDC_SERVICE_ID=                     # Defra service id; leave blank for the stub

# -- Live Defra Identity (Azure AD B2C): set only when OIDC_USE_STUB=false --
# Provide real values via .env / a secrets manager — do not commit them.
#   OIDC_USE_STUB=false
#   OIDC_DISCOVERY_URL=https://<tenant>/idphub/b2c/<policy>/.well-known/openid-configuration
#   OIDC_CLIENT_ID=<your B2C application (client) id>
#   OIDC_CLIENT_SECRET=<your B2C client secret>
#   OIDC_SERVICE_ID=<your Defra service id>
#   OIDC_SCOPES=openid profile email offline_access <client_id>  # B2C wants client id as a scope too
#   OIDC_AUDIENCE=<expected aud claim — usually the B2C client id>  # TODO: not yet read by config (src/config/config.js); wire up later

# ---- Session cookie ---------------------------------------------------------
# Must be at least 32 characters. Local placeholder only; for anything shared
# generate a random one, e.g. `openssl rand -base64 32`.
SESSION_COOKIE_PASSWORD=local-dev-only-session-cookie-change-me-please
# SESSION_COOKIE_SECURE=false        # default: false in dev, true in production
# SESSION_CACHE_ENGINE=memory        # memory (dev default) | redis

# ---- File uploads (CDP uploader) --------------------------------------------
CDP_UPLOADER_URL=http://localhost:7337  # Browser-facing uploader URL (local)

# ---- Redis (only when SESSION_CACHE_ENGINE=redis) ---------------------------
# REDIS_HOST=127.0.0.1
# REDIS_USERNAME=
# REDIS_PASSWORD=
# REDIS_TLS=false
