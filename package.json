{
  "name": "bng-metric-frontend",
  "version": "0.0.0",
  "description": "CDP Frontend Template",
  "sideEffects": false,
  "main": "src/index.js",
  "type": "module",
  "engines": {
    "node": ">=24.14.1"
  },
  "scripts": {
    "build:frontend": "cross-env NODE_ENV=production webpack",
    "dev": "cross-env AWS_EMF_ENVIRONMENT=Local APP_BASE_URL=http://localhost:3000 CDP_UPLOADER_URL=http://localhost:7337 USE_SWAGGER=true OIDC_USE_STUB=true run-p frontend:watch server:watch",
    "dev:b2c": "cross-env AWS_EMF_ENVIRONMENT=Local APP_BASE_URL=http://localhost:3000 CDP_UPLOADER_URL=http://localhost:7337 USE_SWAGGER=true OIDC_USE_STUB=false run-p frontend:watch server:watch",
    "dev:debug": "cross-env AWS_EMF_ENVIRONMENT=Local APP_BASE_URL=http://localhost:3000 CDP_UPLOADER_URL=http://localhost:7337 USE_SWAGGER=true run-p frontend:watch server:debug",
    "docker:dev": "npm run dev",
    "format": "prettier --write \"src/**/*.js\" \"**/*.{js,cjs,md,json,config.js,test.js}\"",
    "format:check": "prettier --check \"src/**/*.js\" \"**/*.{js,cjs,md,json,config.js,test.js}\"",
    "frontend:watch": "cross-env NODE_ENV=development webpack --watch",
    "git:pre-commit-hook": "npm run security-audit && npm run format:check && npm run lint && npm test",
    "install:gitleaks": "node scripts/install-gitleaks.mjs",
    "postinstall": "node scripts/postinstall.mjs",
    "seed:stub-users": "node scripts/seed-stub-users.mjs",
    "lint": "run-s lint:js lint:scss",
    "lint:js": "eslint .",
    "lint:js:fix": "eslint . --fix",
    "lint:scss": "stylelint \"src/**/*.scss\" --cache --cache-location .cache/stylelint --cache-strategy content --color --ignore-path .gitignore",
    "pretest": "npm run build:frontend",
    "test": "cross-env AWS_EMF_ENVIRONMENT=Local TZ=UTC vitest run --coverage",
    "test:watch": "cross-env AWS_EMF_ENVIRONMENT=Local TZ=UTC vitest",
    "security-audit": "npm audit --audit-level=high",
    "server:watch": "nodemon --inspect=0.0.0.0 --ext js,json --legacy-watch ./src",
    "server:debug": "nodemon --inspect-brk=0.0.0.0 --ext js,json --legacy-watch ./src",
    "prestart": "npm run build:frontend",
    "start": "cross-env NODE_ENV=production node --use-strict .",
    "setup:husky": "node -e \"try { (await import('husky')).default() } catch (e) { if (e.code !== 'ERR_MODULE_NOT_FOUND') throw e }\" --input-type module"
  },
  "author": "Defra DDTS",
  "license": "OGL-UK-3.0",
  "dependencies": {
    "@defra/cdp-auditing": "0.6.1",
    "@defra/cdp-metrics": "0.6.0",
    "@defra/hapi-secure-context": "0.4.0",
    "@defra/hapi-tracing": "1.30.0",
    "@elastic/ecs-pino-format": "1.5.0",
    "@hapi/boom": "10.0.1",
    "@hapi/catbox-memory": "6.0.2",
    "@hapi/catbox-redis": "7.0.2",
    "@hapi/crumb": "9.0.1",
    "@hapi/hapi": "21.4.9",
    "@hapi/inert": "7.1.2",
    "@hapi/scooter": "8.0.0",
    "@hapi/vision": "7.0.3",
    "@hapi/wreck": "18.1.2",
    "@hapi/yar": "11.0.3",
    "@ministryofjustice/frontend": "9.0.0",
    "blankie": "5.0.0",
    "convict": "6.2.5",
    "convict-format-with-validator": "6.2.0",
    "cross-env": "10.1.0",
    "cssnano": "8.0.2",
    "cssnano-preset-default": "8.0.2",
    "date-fns": "4.4.0",
    "global-agent": "4.1.3",
    "govuk-frontend": "6.3.0",
    "hapi-pino": "13.0.0",
    "hapi-pulse": "3.0.0",
    "ioredis": "5.11.1",
    "joi": "18.2.3",
    "lodash": "4.18.1",
    "node-fetch": "3.3.2",
    "nunjucks": "3.2.4",
    "openid-client": "6.8.4",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "semver": "7.7.3",
    "swagger-jsdoc": "6.2.8",
    "swagger-ui-dist": "5.32.8",
    "undici": "8.5.0"
  },
  "devDependencies": {
    "@babel/preset-env": "8.0.2",
    "@vitest/coverage-v8": "4.1.7",
    "autoprefixer": "10.5.2",
    "babel-loader": "10.1.1",
    "cheerio": "1.1.2",
    "clean-webpack-plugin": "4.0.0",
    "copy-webpack-plugin": "14.0.0",
    "eslint": "9.39.2",
    "happy-dom": "20.10.6",
    "husky": "9.1.7",
    "neostandard": "0.12.2",
    "nodemon": "3.1.14",
    "npm-run-all": "4.1.5",
    "postcss-load-config": "6.0.1",
    "postcss-loader": "8.2.1",
    "prettier": "3.8.4",
    "sass-embedded": "1.100.0",
    "sass-loader": "17.0.0",
    "source-map-loader": "5.0.0",
    "stylelint": "17.14.0",
    "stylelint-config-gds": "3.0.0",
    "terser-webpack-plugin": "5.6.1",
    "vite": "8.1.0",
    "vitest": "4.1.9",
    "vitest-fetch-mock": "0.4.5",
    "webpack": "5.108.0",
    "webpack-assets-manifest": "6.5.2",
    "webpack-cli": "7.0.3"
  },
  "overrides": {
    "@hapi/wreck": "18.1.2",
    "vitest": "4.1.9",
    "@vitest/coverage-v8": "4.1.7"
  }
}
